# Local environments and agent workspaces.
.venv/
.hermes/
.hermes-runtime/

# Python and test caches.
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
.coverage

# Generated benchmark outputs. Canonical test fixtures remain tracked under tests/fixtures/.
runs/
reports/
artifacts/
data/

# Package build outputs.
dist/
build/
*.egg-info/

# Credentials and mutable Hermes state must never enter Git.
.env
.env.*
!.env.example
auth.json
**/auth.json
*.pem
*.p12
*.pfx
*.key
state.db
**/state.db
sessions/
logs/
